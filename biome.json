{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "scripts/**",
      "android/configurator/**",
      "!android/configurator/profiles",
      "*.json",
      "web/**",
      "!web/vendor",
      "!web/dist",
      "!web/node_modules",
      "!web/test-results",
      "!web/package-lock.json"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noUselessUndefinedInitialization": "on",
        "useLiteralKeys": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  }
}
