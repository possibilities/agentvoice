+#[tokio::test]
+async fn webrtc_v3_client_managed_handoffs_keep_events_without_internal_delegation() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+
+    let mut harness = RealtimeE2eHarness::new(
+        RealtimeTestVersion::V1,
+        no_main_loop_responses(),
+        realtime_sideband(vec![realtime_sideband_connection(vec![vec![
+            session_started("sess_v3_client_managed_delegation"),
+            json!({
+                "type": "delegation.created",
+                "offset_ms": 100,
+                "item": {
+                    "id": "handoff_client_managed",
+                    "type": "delegation",
+                    "target": "client",
+                    "content": [{
+                        "type": "input_text",
+                        "text": "delegate through the client"
+                    }]
+                }
+            }),
+            json!({
+                "type": "input_transcript.added",
+                "item": {
+                    "id": "input_tail",
+                    "type": "input_transcript",
+                    "text": "tail after handoff"
+                }
+            }),
+            json!({
+                "type": "turn.done",
+                "turn": {
+                    "id": "turn_tail",
+                    "role": "user",
+                    "transcript": "tail after handoff"
+                }
+            }),
+        ]])]),
+    )
+    .await?;
+
+    let started = harness
+        .start_webrtc_realtime_with_codex_response_routing(
+            "v=offer\r\n",
+            /*client_managed_handoffs*/ Some(true),
+            /*flush_transcript_tail_on_session_end*/ Some(true),
+            /*codex_responses_as_items*/ None,
+            /*codex_response_handoff_mode*/ None,
+            /*delegation_ack_filler*/ None,
+            RealtimeConversationVersion::V3,
+        )
+        .await?;
+    assert_eq!(started.started.version, RealtimeConversationVersion::V3);
+    // V3 WebRTC sideband startup intentionally sends no session.update. An audio append gives the
+    // request/response test server a client frame to answer with the scripted raw V3 events.
+    harness.append_audio(harness.thread_id.clone()).await?;
+
+    let handoff_item = harness
+        .read_notification::<ThreadRealtimeItemAddedNotification>("thread/realtime/itemAdded")
+        .await?;
+    assert_eq!(handoff_item.thread_id, harness.thread_id);
+    assert_eq!(handoff_item.item["type"], json!("handoff_request"));
+    assert_eq!(
+        handoff_item.item["handoff_id"],
+        json!("handoff_client_managed")
+    );
+    assert_eq!(
+        handoff_item.item["input_transcript"],
+        json!("delegate through the client")
+    );
+
+    assert!(
+        timeout(
+            Duration::from_millis(200),
+            harness.read_notification::<TurnStartedNotification>("turn/started"),
+        )
+        .await
+        .is_err(),
+        "client-managed handoff requests and transcript tails must not start internal turns"
+    );
+
+    let closed = harness
+        .read_notification::<ThreadRealtimeClosedNotification>("thread/realtime/closed")
+        .await?;
+    assert_eq!(closed.thread_id, harness.thread_id);
+    assert!(
+        harness.main_loop_responses_requests().await?.is_empty(),
+        "client-managed realtime delegation must not call the Codex Responses API"
+    );
+
+    harness.shutdown().await;
+    Ok(())
+}
