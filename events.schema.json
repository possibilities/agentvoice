    "__schema8": {
      "type": "number",
      "const": 1
    },
    "__schema9": {
      "type": "string",
      "const": "response"
    },
    "__schema10": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "v": {
          "$ref": "#/$defs/__schema8"
        },
        "type": {
          "$ref": "#/$defs/__schema9"
        },
        "id": {
          "$ref": "#/$defs/__schema10"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "result": {
          "type": "object",
          "properties": {
            "instanceId": {
              "$ref": "#/$defs/__schema12"
