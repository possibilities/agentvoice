        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema32"
            },
            "realtimeSessionId": {
              "$ref": "#/$defs/__schema32"
            },
            "type": {
              "type": "string",
              "const": "transcriptSegment"
            },
            "role": {
              "type": "string",
              "enum": ["user", "assistant"]
            },
            "text": {
              "type": "string",
              "maxLength": 65536
            }
          },
          "required": ["id", "realtimeSessionId", "type", "role", "text"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema32"
            },
            "realtimeSessionId": {
              "$ref": "#/$defs/__schema32"
            },
            "type": {
              "type": "string",
              "const": "bemItemPromoted"
            },
            "turnId": {
              "$ref": "#/$defs/__schema32"
            },
            "itemId": {
              "$ref": "#/$defs/__schema32"
            },
            "presentation": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "wholeItem"
                    }
                  },
                  "required": ["type"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "inlineMarkdown"
                    }
                  },
                  "required": ["type"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "inlineVisualization"
                    },
                    "index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    }
                  },
                  "required": ["type", "index"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": ["id", "realtimeSessionId", "type", "turnId", "itemId", "presentation"],
          "additionalProperties": false
