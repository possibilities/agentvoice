    "__schema34": {
      "type": "string",
      "const": "voice.item.transcript.delta"
    },
    "__schema35": {
      "type": "object",
      "properties": {
        "instanceId": {
          "$ref": "#/$defs/__schema12"
        },
        "generation": {
          "$ref": "#/$defs/__schema13"
        },
        "sequence": {
          "$ref": "#/$defs/__schema14"
        },
        "threadId": {
          "$ref": "#/$defs/__schema32"
        },
        "itemId": {
          "$ref": "#/$defs/__schema32"
        },
        "delta": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "required": ["instanceId", "generation", "sequence", "threadId", "itemId", "delta"],
      "additionalProperties": false
