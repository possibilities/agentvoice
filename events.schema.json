                "status": {
                  "type": "string",
                  "enum": ["inProgress", "completed", "interrupted", "failed"]
                }
              },
              "required": ["id", "status"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["id", "parentThreadId", "name", "status", "activeFlags", "turn"],
      "additionalProperties": false
    },
    "__schema19": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "__schema20": {
      "type": "string",
      "enum": ["waitingOnApproval", "waitingOnUserInput"]
    },
    "__schema21": {
      "type": "object",
