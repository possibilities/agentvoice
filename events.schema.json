            "code": {
              "type": "string",
              "enum": ["invalid_request", "invalid_params", "unknown_method", "internal_error"]
            },
            "message": {
              "type": "string"
            }
          },
          "required": ["code", "message"],
          "additionalProperties": false
        }
      },
      "required": ["v", "type", "id", "ok", "error"],
      "additionalProperties": false
