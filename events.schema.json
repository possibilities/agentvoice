        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema32"
            },
            "realtimeSessionId": {
              "$ref": "#/$defs/__schema32"
            },
            "type": {
              "type": "string",
              "const": "realtimeSessionClosed"
            },
            "outcome": {
              "type": "string",
              "enum": ["ended", "failed"]
            }
          },
          "required": ["id", "realtimeSessionId", "type", "outcome"],
          "additionalProperties": false
        }
      ]
