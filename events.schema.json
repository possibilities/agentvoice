          "description": "Lifecycle state only. Its watermark never supersedes transient voice events."
        }
      },
      "required": ["v", "type", "id", "ok", "result"],
      "additionalProperties": false
    },
    "__schema12": {
      "type": "string",
      "minLength": 1,
      "description": "Producer lifetime ID; changes on full restart."
    },
    "__schema13": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Runtime generation within that lifetime."
    },
    "__schema14": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Monotonic publication sequence, not a replay cursor."
    },
    "__schema15": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        },
        "mainThreadId": {
          "type": "string"
        }
      },
      "required": ["phase", "workspace", "mainThreadId"],
      "additionalProperties": false
    },
    "__schema16": {
      "type": "string",
      "enum": ["pending", "ready", "incomplete", "unavailable"]
    },
    "__schema17": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema18"
      }
    },
    "__schema18": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema19"
