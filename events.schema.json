        "activeFlags": {
          "maxItems": 2,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema20"
          }
        },
        "turn": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/$defs/__schema19"
