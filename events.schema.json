    },
    "__schema36": {
      "type": "string",
      "const": "voice.item.completed"
    },
    "__schema37": {
      "type": "object",
      "properties": {
        "instanceId": {
          "$ref": "#/$defs/__schema12"
        },
        "generation": {
          "$ref": "#/$defs/__schema13"
        },
        "sequence": {
          "$ref": "#/$defs/__schema14"
        },
        "threadId": {
          "$ref": "#/$defs/__schema32"
        },
        "item": {
          "$ref": "#/$defs/__schema33"
        }
      },
      "required": ["instanceId", "generation", "sequence", "threadId", "item"],
      "additionalProperties": false
    }
  },
  "title": "AgentVoice event socket",
  "description": "Fleet NDJSON event contract: event.subscribe and state.get, correlated responses, and named typed events. Lifecycle events reconcile by snapshot watermark; transient voice events never do. Filtering, ordering, byte limits and delivery semantics are documented in docs/events.md."
}
