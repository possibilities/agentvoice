                    },
                    "detail": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": ["type", "sessionId", "detail"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "mute"
                    },
                    "sessionId": {
                      "$ref": "#/$defs/__schema3"
                    },
                    "target": {
                      "type": "string",
                      "enum": ["mic", "speaker"]
                    },
                    "muted": {
                      "type": "boolean"
                    }
                  },
                  "required": ["type", "sessionId", "target", "muted"],
                  "additionalProperties": false
