                    "target": {
                      "type": "string",
                      "enum": ["mic", "speaker"]
                    },
                    "muted": {
                      "type": "boolean"
                    }
                  },
                  "required": ["action", "target", "muted"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "enum": ["hold", "release"]
                    }
                  },
                  "required": ["action"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": ["v", "type", "id", "method", "params"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "$ref": "#/$defs/__schema0"
            },
            "type": {
              "$ref": "#/$defs/__schema1"
            },
            "id": {
              "$ref": "#/$defs/__schema2"
            },
            "method": {
              "type": "string",
              "const": "client-media"
            },
            "params": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
