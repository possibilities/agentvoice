              "$ref": "#/$defs/__schema4"
            }
          },
          "required": ["v", "type", "state"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 2
            },
            "type": {
              "type": "string",
              "const": "observation"
            },
            "observation": {
              "$ref": "#/$defs/__schema6"
            }
          },
          "required": ["v", "type", "observation"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 2
            },
            "type": {
              "type": "string",
              "const": "client-media"
            },
            "message": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "prepare"
                    },
                    "sessionId": {
                      "$ref": "#/$defs/__schema3"
                    }
                  },
                  "required": ["type", "sessionId"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "answer"
                    },
                    "sessionId": {
                      "$ref": "#/$defs/__schema3"
                    },
                    "sdp": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 196608
                    }
                  },
                  "required": ["type", "sessionId", "sdp"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "close"
                    },
                    "sessionId": {
                      "$ref": "#/$defs/__schema3"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": ["type", "sessionId"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "state"
                    },
                    "sessionId": {
                      "$ref": "#/$defs/__schema3"
                    },
                    "mic": {
                      "$ref": "#/$defs/__schema7"
                    },
