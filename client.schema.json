  "$defs": {
    "__schema0": {
      "type": "number",
      "const": 2
    },
    "__schema1": {
      "type": "string",
      "const": "request"
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "__schema3": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "phase": {
          "type": "string",
          "enum": ["waiting-ready", "negotiating", "live", "failed", "stopped"]
        },
        "mic": {
          "$ref": "#/$defs/__schema5"
        },
        "speaker": {
          "$ref": "#/$defs/__schema5"
        }
      },
      "required": ["available", "phase", "mic", "speaker"],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "muted": {
          "type": "boolean"
        },
        "effectiveMuted": {
          "type": "boolean"
        }
      },
      "required": ["muted", "effectiveMuted"],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "busy": {
          "type": "boolean"
        },
        "availability": {
          "type": "string",
          "enum": ["idle", "connected", "closing", "unavailable"]
        },
        "clientId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "threadId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema4"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["busy", "availability", "clientId", "workspace", "threadId", "state"],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "muted": {
          "type": "boolean"
        },
        "effectiveMuted": {
          "type": "boolean"
        }
      },
      "required": ["muted", "effectiveMuted"],
      "additionalProperties": false
    }
  },
  "title": "AgentVoice client API v2",
  "description": "Exclusive call ownership and client-owned media signaling. See docs/client-api.md. No credentials or audio bytes."
}
