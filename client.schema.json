                  "type": "object",
                  "properties": {
                    "busy": {
                      "type": "boolean"
                    },
                    "workspace": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "threadId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": ["busy", "workspace", "threadId"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": ["v", "type", "id", "ok", "result"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "type": "number",
              "const": 2
            },
            "type": {
              "type": "string",
              "const": "response"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "ok": {
              "type": "boolean",
              "const": false
            },
            "error": {
              "type": "object",
