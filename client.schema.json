                    "sessionId": {
                      "$ref": "#/$defs/__schema3"
                    }
                  },
                  "required": ["type", "sessionId"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": ["v", "type", "id", "method", "params"],
          "additionalProperties": false
