                }
              },
              "required": ["clientId"],
              "additionalProperties": false
            }
          },
          "required": ["v", "type", "id", "method", "params"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "$ref": "#/$defs/__schema0"
            },
            "type": {
              "$ref": "#/$defs/__schema1"
            },
            "id": {
              "$ref": "#/$defs/__schema2"
            },
            "method": {
              "type": "string",
              "const": "input"
            },
            "params": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
