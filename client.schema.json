              "required": ["message"],
              "additionalProperties": false
            }
          },
          "required": ["v", "type", "id", "ok", "error"],
          "additionalProperties": false
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 2
        },
        "type": {
          "type": "string",
          "enum": ["ping", "pong"]
        },
        "nonce": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      },
      "required": ["v", "type", "nonce"],
      "additionalProperties": false
    }
