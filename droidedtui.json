{
  "schemaVersion": 1,
  "name": "AgentVoice Remote",
  "applicationId": "com.possibilities.agentvoice.remote",
  "version": {
    "name": "0.2.0",
    "code": 2
  },
  "entry": "src/console/android-remote.ts",
