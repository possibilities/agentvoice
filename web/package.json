{
  "name": "agentvoice-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && bun --bun vite build",
    "check": "npm run build",
    "preview": "bun --bun vite preview",
    "test:api": "bun test server-tests",
    "test:browser": "playwright test",
    "test": "npm run test:api && npm run test:browser"
  },
  "dependencies": {
    "@agentchats/transcript": "file:vendor/agentchats-transcript-0.3.4.tgz",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "portless": "0.15.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
