{
  "name": "agentvoice-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "npm run transcript:styles:check && tsc --noEmit && tsc --noEmit -p tsconfig.server.json && bun --bun vite build",
    "check": "npm run build",
    "preview": "bun --bun vite preview",
    "test:api": "bun test server-tests",
    "test:browser": "playwright test",
    "test": "npm run test:api && npm run test:browser",
    "transcript:styles": "bun scripts/build-transcript-styles.ts --write",
    "transcript:styles:check": "bun scripts/build-transcript-styles.ts --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@pierre/diffs": "^1.4.2",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-virtual": "3.14.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lowlight": "3.3.0",
    "lucide-react": "^1.45.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-to-string": "^4.0.0",
    "micromark-util-sanitize-uri": "2.0.1",
    "portless": "0.15.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "postcss": "^8.5.28",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
