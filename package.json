{
  "name": "agentvoice-eval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless full-duplex evaluation harness for coding voice agents.",
  "scripts": {
    "render:fixture": "bun run src/tts-cli.ts",
    "tui": "bun run src/tui/main.ts",
    "native:build": "bun run scripts/build-native.ts",
    "build:codex-app-server": "scripts/build-codex-app-server.sh",
    "check:codex-patch": "scripts/build-codex-app-server.sh --check",
    "eval:codex": "bun run src/cli.ts run codex",
    "eval:codex-fx": "bun run src/cli.ts run codex-fx",
    "eval:livekit": "bun run src/cli.ts run livekit",
    "judge": "bun run src/judge-cli.ts",
    "judge:audio": "bun run src/pairwise-audio-judge-cli.ts",
    "validate:codpiece-artifact": "bun run src/codpiece-artifact-validator-cli.ts",
    "probe:codex": "bun run src/cli.ts probe codex",
    "probe:codex-fx": "bun run src/cli.ts probe codex-fx",
    "probe:fx": "bun run src/cli.ts probe fx",
    "probe:livekit": "bun run src/cli.ts probe livekit",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "dependencies": {
    "@livekit/agents": "1.7.1",
    "@livekit/agents-plugin-openai": "1.7.1",
    "@livekit/protocol": "1.50.4",
    "@livekit/rtc-node": "0.13.34",
    "@opentui/core": "0.5.3",
    "livekit-server-sdk": "2.18.0",
    "opusscript": "0.1.1",
    "werift": "0.24.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/bun": "1.4.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=24.0.0"
  }
}
