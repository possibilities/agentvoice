{
  "name": "agentvoice",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/possibilities/agentvoice.git"
  },
  "private": true,
  "type": "module",
  "description": "Minimal voice server over the Codex app-server realtime (WebRTC) surface.",
  "bin": {
    "agentvoice": "./src/main.ts"
  },
  "scripts": {
    "server": "bun run src/main.ts server",
    "client": "bun run src/main.ts client",
    "setup": "bun run scripts/setup.ts",
    "native:build": "bun run scripts/build-native.ts",
    "audio:probe": "bun run scripts/audio-probe.ts",
    "accounts:probe": "bun run scripts/account-profiles-probe.ts",
    "resident:probe": "bun run scripts/resident-probe.ts",
    "cli:install": "bun run scripts/install.ts",
    "generate:schema": "bun run scripts/generate-schema.ts && biome check --write server.schema.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@opentui/core": "^0.5.1",
    "opusscript": "^0.1.1",
    "werift": "^0.24.3",
    "zod": "^4.4.3"
  }
}
