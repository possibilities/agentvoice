{
  "name": "agentvoice",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/possibilities/agentvoice.git"
  },
  "private": true,
  "type": "module",
  "description": "Foreground Codex voice TUI with workspace-local native conversations.",
  "bin": {
    "agentvoice": "./src/main.ts"
  },
  "scripts": {
    "console": "bun run src/main.ts console",
    "setup": "bun run scripts/setup.ts",
    "native:build": "bun run scripts/build-native.ts",
    "audio:probe": "bun run scripts/audio-probe.ts",
    "field:demo": "bun run scripts/signal-field-demo.ts",
    "cli:install": "bash scripts/install.sh --install",
    "generate:schema": "bun run scripts/generate-schema.ts && biome check --write server.schema.json",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "app-server:probe": "bun run scripts/app-server-probe.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opentui/core": "0.5.3",
    "opusscript": "^0.1.1",
    "werift": "^0.24.3",
    "zod": "^4.4.3"
  }
}
