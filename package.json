{
  "name": "agentvoicenext",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal voice server over the Codex app-server realtime (WebRTC) surface.",
  "bin": {
    "agentvoicenext": "./src/main.ts"
  },
  "scripts": {
    "server": "bun run src/main.ts server",
    "client": "bun run src/main.ts client",
    "setup": "bun run scripts/setup.ts",
    "cli:install": "bun run scripts/install.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@opentui/core": "^0.5.1",
    "opusscript": "^0.1.1",
    "werift": "^0.24.3"
  }
}
