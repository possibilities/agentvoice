<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/themed_notification_phase" style="@android:style/TextAppearance.Material.Notification.Line2"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
        android:textSize="13sp" android:textColor="@color/themed_notification_phase" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
        <Button android:id="@+id/themed_notification_microphone" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginEnd="8dp"
            android:background="@drawable/themed_notification_human_button" android:textColor="@color/themed_notification_human" android:backgroundTint="@null" android:stateListAnimator="@null" android:elevation="0dp" android:minWidth="48dp" android:minHeight="48dp" android:paddingHorizontal="8dp" android:paddingVertical="4dp"
        android:fontFamily="sans-serif" android:textSize="14sp" android:textStyle="bold" android:textAllCaps="false" android:includeFontPadding="false" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" />
        <Button android:id="@+id/themed_notification_hang_up" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:background="@drawable/themed_notification_end_button" android:textColor="@color/themed_notification_end" android:text="@string/themed_notification_hang_up" android:contentDescription="@string/themed_notification_hang_up" android:backgroundTint="@null" android:stateListAnimator="@null" android:elevation="0dp" android:minWidth="48dp" android:minHeight="48dp" android:paddingHorizontal="8dp" android:paddingVertical="4dp"
        android:fontFamily="sans-serif" android:textSize="14sp" android:textStyle="bold" android:textAllCaps="false" android:includeFontPadding="false" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
    <Button android:id="@+id/themed_notification_speaker" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp"
        android:background="@drawable/themed_notification_agent_button" android:backgroundTint="@null" android:stateListAnimator="@null" android:elevation="0dp"
        android:minWidth="48dp" android:minHeight="48dp" android:paddingHorizontal="12dp" android:paddingVertical="4dp"
        android:fontFamily="sans-serif" android:textSize="13sp" android:textAllCaps="false" android:textColor="@color/themed_notification_agent" android:includeFontPadding="false" android:maxLines="1" />
</LinearLayout>
